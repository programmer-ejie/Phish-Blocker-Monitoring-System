{
  "manifest_version": 3,
  "name": "PhishBlock (preload)",
  "version": "1.0",
  "description": "Preloads a blocking overlay and checks page URL with your phishing API.",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": [
    "https://phishing-api-uijh.onrender.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["config.json"],
    "matches": ["<all_urls>"]
  }]
}
